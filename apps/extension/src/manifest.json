{
  "manifest_version": 3,
  "name": "Wardeye",
  "version": "0.1.2",
  "description": "Place the ward. See the table. Wardeye names the cards on the table of Riftbound streams on Twitch, on your own computer.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Wardeye is on. Click to turn it off (Alt+R)",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "worker.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://www.twitch.tv/*"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/SpaceGrotesk-latin.woff2", "fonts/Inter-latin.woff2", "fonts/JetBrainsMono-latin.woff2"],
      "matches": ["https://www.twitch.tv/*"]
    }
  ],
  "permissions": ["offscreen"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
